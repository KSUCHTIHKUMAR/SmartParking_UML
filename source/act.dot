{rank=same;s;a;b;c}{rank=same;g;f;e;d}{rank=same;h;j;l;n;z}
s->a->b->c;c->d[label=" Yes"];d->e;e->f;f->g[label=" Yes"];g->h;h->j->l->n->z;
c->b[label=" No",constraint=false,tailport=n,headport=n];f->e[label=" No",constraint=false,tailport=s,headport=s];
